*_trace.jsonl
trace_*.jsonl
debug_*/
samples*.jsonl
*report*.html

# Run directories hold images, scans and terrain maps and stay out of git.
# Written as runs/* rather than runs/ so the two small text files that make a
# run re-scorable can be negated below -- git cannot re-include a file whose
# parent directory is itself excluded.
runs/*
!runs/README.md
!runs/*/
runs/*/*
!runs/*/steps.jsonl
!runs/*/plan.json
# Model weights — auto-downloaded by ultralytics on first run (too big for GitHub)
*.pt
weights/
# Captured perception datasets / sample frames + live run artifacts (large, regenerable)
dataset_generator/captures/
dataset_generator/branchA_sample/
dataset_generator/live_frames/

# Session artefacts — captured frames, sweep outputs, cached VLM replies
snaps/
frames_first/
artifacts/
# score_if.py --json output: derived from runs/, which is ignored above,
# so it cannot be reproduced from a clean checkout and would churn per machine.
scores.json

