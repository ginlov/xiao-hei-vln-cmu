# Exploration algorithm and hyperparameters — the locked configuration.
#
# Every value the explorers use is here. Nothing is hard-coded in
# src/xiao_hei_vln/app/main.py any more, so porting to the submission repo is
# copying this file and pointing compose at it:
#
#   services:
#     ai_module:
#       env_file: [config/exploration.env]
#
# Anything already set in the environment wins over the value here, so a sweep
# can override one knob without editing the file:
#
#   XIAO_HEI_EXPLORATION_NBV_N_SAMPLES=80 scripts/exploration_sweep.sh loft
#
# Values were measured on the exp0/exp1 sweeps (13 Unity scenes, both
# strategies, 480 s each). See docs/tasks/TASK 50 and TASK 51 — and TASK 52 for
# why the default is nbv, which rests on weaker evidence than the rest of this
# file.

# ---------------------------------------------------------------------------
# Strategy and budget

# frontier | nbv. An unrecognised value disables exploration with an error —
# it does NOT fall back, so a typo fails loudly rather than silently running
# something else.
XIAO_HEI_EXPLORATION_STRATEGY=nbv

# Waypoint budget. 0 disables exploration entirely and answers immediately.
# 500 is effectively "no limit": the wall clock ends every real sweep first,
# the most any scene reached was 32.
XIAO_HEI_EXPLORATION_MAX_WAYPOINTS=500

# Wall-clock cutoff, seconds. Starts at the first tick with a pose, not at node
# boot — /state_estimation takes 90-190 s to arrive and the robot cannot
# explore before it does, so this is 8 min of exploring, not 8 min of uptime.
XIAO_HEI_EXPLORATION_MAX_SECONDS=480

# ---------------------------------------------------------------------------
# Shared: occupancy grid

# Metres per cell. 0.2 m is the terrain map's own resolution; going finer
# multiplies the BFS cost without adding information.
XIAO_HEI_EXPLORATION_GRID_RESOLUTION=0.2

# terrain_ext cost at or below which a cell counts as traversable.
XIAO_HEI_EXPLORATION_COST_THRESHOLD=0.5

# How close the robot must get for odometry alone to count a waypoint reached.
# The nav stack normally settles 0.25-0.90 m out and signals separately; this
# is the fallback for when it does not.
XIAO_HEI_EXPLORATION_REACH_DIST=0.3

# Seconds to pursue one waypoint before skipping it. Deliberately short: the
# robot maps while *driving toward* a target rather than on arrival, so cycling
# through many headings sweeps more new space than committing to few.
# Lengthening this was tried twice and lost coverage both times (TASK 51).
XIAO_HEI_EXPLORATION_WP_TIMEOUT_S=12

# ---------------------------------------------------------------------------
# NBV (the default strategy)

# Candidate poses scored per selection. Frontier cells are all scored first,
# nearest-first, up to this cap; random free-space draws only fill the
# remainder. Raising it costs BFS time for diminishing returns.
XIAO_HEI_EXPLORATION_NBV_N_SAMPLES=40

# Consecutive skips before the sweep is declared stalled. The counter resets
# whenever the map is still growing, so this only fires when the robot has
# genuinely stopped discovering.
XIAO_HEI_EXPLORATION_NBV_MAX_SKIPS=25

# Free cells the map must gain to bank progress and reset that counter.
# 60 cells at 0.2 m is 2.4 m2.
XIAO_HEI_EXPLORATION_NBV_SKIP_RESET_CELLS=60

# Radius (cells) suppressed from future targeting around a reached waypoint,
# and around a skipped one. Suppression does NOT change traversability — that
# distinction is what stopped nbv walling itself off from its own map.
XIAO_HEI_EXPLORATION_NBV_VISIT_MARK_CELLS=3
XIAO_HEI_EXPLORATION_NBV_SKIP_MARK_CELLS=4

# RNG seed for the free-space sampling. Fixed so a sweep is reproducible;
# change it only to measure run-to-run variance.
XIAO_HEI_EXPLORATION_NBV_SEED=0

# ---------------------------------------------------------------------------
# Frontier (kept selectable; was the default through exp0-exp2)

# Cells a frontier cluster needs before it is scored. Undersized clusters are
# used as a fallback rather than ending the sweep.
XIAO_HEI_EXPLORATION_FRONTIER_MIN_CLUSTER=5

# Preferred maximum distance to a target, metres. Beyond it the nearest valid
# cluster is the fallback.
XIAO_HEI_EXPLORATION_MAX_WAYPOINT_DIST=1.5

XIAO_HEI_EXPLORATION_FRONTIER_MAX_SKIPS=20

# Metres around a failed centroid within which a new target will not be
# proposed. Without it the remaining cells of a cluster re-average to nearly
# the same point and the same target is re-issued indefinitely — observed 18x
# in a row on `loft`.
XIAO_HEI_EXPLORATION_FRONTIER_REJECT_RADIUS=0.8

# Consecutive selection ticks returning nothing before the scene is called
# finished. terrain_ext arrives in bursts, so one barren tick is noise, not
# coverage.
XIAO_HEI_EXPLORATION_FRONTIER_EMPTY_TICKS=20

XIAO_HEI_EXPLORATION_FRONTIER_SKIP_RESET_CELLS=60

# ---------------------------------------------------------------------------
# Artefacts and diagnostics

# Seconds between exploration.png / rviz.png rewrites (0 = only on DONE).
XIAO_HEI_EXPLORATION_SNAPSHOT_S=30

# Seconds between MAP heartbeat lines (0 = off). This is the coverage curve:
# free / occupied / frontier / reachable / free_m2 and the true path length.
# free_m2 is the number to compare runs on — every waypoint-derived proxy
# (reach rate, visited count, path length) has at some point moved opposite to
# actual coverage.
XIAO_HEI_EXPLORATION_MAP_LOG_S=10
